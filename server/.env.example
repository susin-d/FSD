NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/nearby
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Optional local DNS override for networks that block MongoDB SRV lookups.
# Keep blank by default and do not set this in production without a network-specific reason.
MONGODB_DNS_SERVERS=

# Razorpay test credentials for local checkout; keep real values server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Enable Route in the admin marketplace settings after the account is approved.

# Email notifications use SMTP. Leave unset to keep notifications disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Nearby <no-reply@example.com>

# Local-only pending stub; it never verifies a provider. Replace the adapter before production.
KYC_PROVIDER=development_stub

